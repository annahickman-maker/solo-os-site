# Supabase (the same project your dashboard uses; the dashboard owns the schema)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin. Optional: derived from the request when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the dashboard sends as x-api-key when it publishes articles here.
# Must equal API_SECRET_KEY on the dashboard.
API_SECRET_KEY=your-api-secret-key

# Lead capture: your dashboard's URL and its CRM capture key
BACKEND_URL=http://localhost:3001
CRM_CAPTURE_KEY=your-crm-capture-key

# Checkout buttons: a dashboard agent key with only money:checkout
CHECKOUT_API_KEY=

# Optional: only for /api/email/send and /api/email/webhook
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
